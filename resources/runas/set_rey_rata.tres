; SANGRE REAL (31/10, el set de ARMADURA del Rey Rata; diseño del jefe): 2 piezas +10 % de Ataque; 5 piezas +2 % de
; daño por cada carga de Sangrado SUMANDO todos los enemigos de la pelea, hasta +16 %.
[resource]
script = ExtResource("1")
id = &"rey_rata"
nombre = "Sangre real"
tipo = 1
material = ExtResource("2_mat")
nucleo = ExtResource("3_nuc")
coste_material = 6
coste_nucleo = 3
runa = ExtResource("4_runa")
