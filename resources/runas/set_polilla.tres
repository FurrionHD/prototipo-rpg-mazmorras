[gd_resource type="Resource" script_class="RunaSetData" format=3]

[ext_resource type="Script" path="res://scripts/items/runa_set_data.gd" id="1"]
[ext_resource type="Resource" path="res://resources/materials/polvo_de_alas.tres" id="2_mat"]
[ext_resource type="Resource" path="res://resources/materials/nucleo_polilla.tres" id="3_nuc"]
[ext_resource type="Resource" path="res://resources/materials/runa_polilla.tres" id="4_runa"]

; CONCENTRACION (12/11, aprobado: "asi es perfecto"; memoria polilla-mutante), set de ARMA de la polilla: cada frase bien
; recitada, +4 % de daño magico (hasta 5); fallar una frase lo pierde todo. Dura la pelea, de hechizo en hechizo.
[resource]
script = ExtResource("1")
id = &"polilla"
nombre = "Concentración"
tipo = 0
material = ExtResource("2_mat")
nucleo = ExtResource("3_nuc")
coste_material = 6
coste_nucleo = 3
runa = ExtResource("4_runa")
bonus_2p = {}
efecto = &"concentracion"
params = {"por_frase": 0.04, "max": 5}
metadata/_custom_type_script = "res://scripts/items/runa_set_data.gd"
