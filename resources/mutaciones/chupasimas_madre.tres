[gd_resource type="Resource" script_class="MutacionData" format=3]

[ext_resource type="Script" path="res://scripts/actors/enemy/mutacion_data.gd" id="1_mut"]
[ext_resource type="Script" path="res://scripts/items/ability_data.gd" id="2_ab"]
[ext_resource type="Resource" path="res://resources/abilities/chupasimas_adherirse.tres" id="3_adh"]
[ext_resource type="Resource" path="res://resources/abilities/chupasimas_drenaje_madre.tres" id="4_dre"]
[ext_resource type="Resource" path="res://resources/abilities/chupasimas_rayo_mana.tres" id="5_ray"]
[ext_resource type="Resource" path="res://resources/abilities/chupasimas_mordisco_vidriado.tres" id="6_bas"]

; LA MADRE DE LAS SIMAS (18/11, memoria chupasimas-mutante): el RANGO 2 de las dos ramas de la chupasimas. Sale del Coagulo
; y de la Sanguijuela vidriada, asi que va en SU PROPIO ARCHIVO. Junta las dos: la COSTRA DE SANGRE del Coagulo (de lo que
; drena, 150 %) y la SED DE MANA y el RAYO de la Vidriada. Se pega (Adherirse FISICO) y se SUELTA SOLA con el rayo lleno.
; Su basico y su Drenaje, MAGICOS sin elemento; el Drenaje ademas bebe el 10 % del mana.
[resource]
script = ExtResource("1_mut")
id = &"madre"
nombre = "Madre de las simas"
grado = 2
desde = Array[StringName]([&"coagulo", &"vidriada"])
habilidades = Array[ExtResource("2_ab")]([ExtResource("3_adh"), ExtResource("4_dre"), ExtResource("5_ray")])
sprite = &"madre"
basico_propio = ExtResource("6_bas")
pesos = {"agilidad": 18, "destreza": 18, "fuerza": 22, "magia": 34, "resistencia": 38, "voluntad": 25}
costra_sangre = 1.5
costra_fisico = 0.5
costra_resist = {
2: 1.3,
3: 1.0
}
sed_de_mana = true
suelta_con_rayo = true
; (18/11) a la vista en su ficha: StatusEffects.Id.COSTRA_SANGRE y SED_MANA
pasivas_visibles = Array[int]([67, 68])
