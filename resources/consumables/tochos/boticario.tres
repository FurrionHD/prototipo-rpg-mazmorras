script = ExtResource("1_mbd73")
nombre = "Del despilfarro del boticario"
descripcion = "Un boticario arruinado explica, con mucho rencor, por qué la gente gasta el triple de pociones de las que necesita. Su consejo, entre insulto e insulto: prueba a esperar un poco después de beberte una, que la cura va cayendo sola y el impaciente se bebe la siguiente encima de la anterior. Se le nota que le ha costado dinero."
