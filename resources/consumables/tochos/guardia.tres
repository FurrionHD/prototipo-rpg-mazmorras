[resource]
script = ExtResource("1_2d23y")
nombre = "Tratado de la guardia"
descripcion = "Defiende que aguantar es un oficio como otro cualquiera y que nadie lo entrena a propósito. Al final va al grano: si quieres que tu cuerpo aprenda a recomponerse solo, prueba a parar los golpes con la guardia arriba en vez de esquivarlos todos. Esquivando no se aprende nada, dice, y se queda tan ancho."
