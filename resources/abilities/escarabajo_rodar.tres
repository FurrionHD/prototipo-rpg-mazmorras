[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://scripts/items/ability_data.gd" id="1"]

[resource]
script = ExtResource("1")
nombre = "Embestida rodante"
descripcion = "Se enrosca sobre sí mismo y se lanza rodando como una bola de hierro. Tarda un instante en coger impulso; aturdirlo lo frena en seco."
coste_energia = 0.0
golpes_min = 1
golpes_max = 1
dano_mult = 1.9
area_modo = 1
area_max = 3
area_secundario = 0.5
carga_turnos = 1
fx_anim = &"rodar"
; SIN EFECTO DIBUJADO, que es el caso que estrena la regla. 0 es MELEE, cuyo tiempo de vuelo es 0.0,
; y un estilo a 0.0 no llega a darse de alta (ver CombatFX: "CERO SIGNIFICA NO SE DIBUJA NADA"). Ojo:
; -1 NO vale, cae al fx_basico. El efecto RODADA pintaba la bola girando con estelas y polvo ENCIMA
; del escarabajo -- que es como se cuenta una rodada cuando el bicho no sabe rodar. Ahora rueda de
; verdad, asi que el dibujo seria una segunda rodada encima de la primera.
fx_estilo = 0
cooldown = 4
