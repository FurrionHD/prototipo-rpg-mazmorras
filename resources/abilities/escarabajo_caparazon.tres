[sub_resource type="Resource" id="SA_fort"]
script = ExtResource("2")
estado = 6
en_objetivo = false

[resource]
script = ExtResource("1")
nombre = "Caparazón"
descripcion = "Se repliega bajo su coraza y aprieta las placas. Durante un rato, pega y aguanta como si fuera el doble de duro."
coste_energia = 0.0
dano_mult = 0.0
efectos = [SubResource("SA_fort")]
# QUIETO (0) Y NO AUTO. Es la contrapartida de haber puesto fx_estilo = 0: AUTO da un paso adelante
# "si el estilo es cuerpo a cuerpo", y MELEE lo es -- estaria deshaciendo justo lo que se busca, que
# la tarjeta deje de lanzarse por un buff que no toca a nadie. Con el estilo anterior no hacia falta
# porque aquel no estaba en _CUERPO_A_CUERPO y AUTO ya lo dejaba quieto.
gesto = 0
fx_anim = &"caparazon"
# SIN EFECTO DIBUJADO. 0 es MELEE, cuyo tiempo de vuelo es 0.0, y un estilo a 0.0 no llega a darse
# de alta (ver CombatFX: "CERO SIGNIFICA NO SE DIBUJA NADA"). Ojo: -1 NO vale, cae al fx_basico del
# bicho. El efecto CAPARAZON pintaba el escarabajo visto DESDE ARRIBA cerrandose, o sea un segundo
# escarabajo encima del escarabajo: con el bicho cerrandose de verdad, sobra.
fx_estilo = 0
cooldown = 5
