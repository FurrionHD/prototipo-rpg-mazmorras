[resource]
script = ExtResource("1")
nombre = "Cornada"
descripcion = "Baja la testuz y ensarta con los cuernos. La herida que abre no cierra sola: te deja sangrando."
coste_energia = 0.0
golpes_min = 1
golpes_max = 1
dano_mult = 1.9
efectos = [SubResource("SA_sangrado")]
efectos_por_golpe = false
fx_anim = &"mino_cornada"
; EL CUERPO (01/10): mientras avisa se pone a cuatro patas (el hacha a la espalda) y escarba; al soltar embiste y engancha.
fx_anim_carga = &"mino_agacharse>mino_agazapado"
fx_estilo = 20
cooldown = 4
; EN EL MAPA (01/10, Minotauro paso 1): embiste por una LINEA de 120 cargada 1 turno (la huella roja avisa), se para en
; el primero que pilla y lo DESPLAZA lejos (40 px: un desplazamiento grande, le corta lo que estuviera cargando).
forma = 3
forma_apunte = 1
forma_radio = 120.0
forma_ancho = 28.0
carga = true
carga_turnos = 1
tiron = -40.0
