[resource]
script = ExtResource("1")
nombre = "Avance cubierto"
precio = 2500
coste_energia = 58
cooldown = 5
; (26/11, cerrado con el jefe) LA TECNICA DEL ESTOQUE CON RODELA: corres por la linea con la rodela delante hasta el
; primero que pillas; al llegar, el RODELAZO (golpe 0, con tu Defensa) y por el hueco la ESTOCADA (golpe 1, con tu arma).
; Te deja en guardia. Solo con escudo PEQUEÑO (escudos_tamanos). Se parece a la Embestida de la rodela (todo escudo y
; empuja); esta te deja pegado a el y pega con el estoque.
forma = 3
forma_apunte = 1
forma_radio = 110.0
forma_ancho = 16.0
forma_solo_primero = true
carga = true
golpes_min = 2
golpes_max = 2
dano_mult = 1.0
mults_golpe = [0.9, 2.0]
escudo_hasta_golpe = 0
penetracion_extra = 0.2
redirige_al_morir = true
efectos = [SubResource("SA_stun")]
efectos_por_golpe = false
bloqueo_turnos = 1
requiere_escudo = true
escudos_tamanos = [0]
fx_estilo = 41
descripcion = "Técnica de estoque y rodela: corres hacia el primero que se te cruce con la rodela por delante, le das con ella y, por el hueco que abre, le metes la estocada. Quedas en guardia. El primer golpe es del escudo y pega con tu defensa; el segundo, del arma."
; EL ARBOL (24/11, cerrado con el jefe): lo escribe tools/arboles_habilidades.py, no tocarlo a mano.
arbol = [SubResource("NM_ava_carrera_larga"), SubResource("NM_ava_rodelazo_aturde"), SubResource("NM_ava_peso_carrera"), SubResource("NM_ava_abrir_guardia"), SubResource("NM_ava_arrollar"), SubResource("NM_ava_retar"), SubResource("NM_ava_doble_estocada"), SubResource("NM_ava_escudo_devuelve"), SubResource("NM_ava_llegar_cubierto"), SubResource("NM_ava_linea_6"), SubResource("NM_ava_linea_7"), SubResource("NM_ava_linea_8"), SubResource("NM_ava_linea_9"), SubResource("NM_ava_linea_10"), SubResource("NM_ava_linea_11"), SubResource("NM_ava_linea_12"), SubResource("NM_ava_linea_13"), SubResource("NM_ava_linea_14"), SubResource("NM_ava_linea_15"), SubResource("NM_ava_linea_16")]
