[sub_resource type="Resource" id="NM_sen_marca_honda"]
script = ExtResource("nodo_mejora")
id = &"marca_honda"
nombre = "Marca honda"
descripcion = "No señala un hueco: señala EL hueco."
padres = Array[StringName]([])
excluye = Array[StringName]([&"marca_larga"])
nivel_min = 2
dominio = 300
oro = 10000
cambios = {"efectos_mult_de": ["add", {15: 1.4}], "potencia": ["presupuesto", 0.5], "potencia_coste": ["presupuesto", 1.0]}

