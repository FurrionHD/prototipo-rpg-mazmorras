[resource]
script = ExtResource("1")
golpe_txt = "de cada puñalada"
nombre = "Desaparecer"
precio = 2500
coste_energia = 34
cooldown = 5
golpes_min = 1
golpes_max = 1
dano_mult = 0.6
fx_estilo = 35
fx_sobre_mi = 39
redirige_al_morir = true
golpes_extra_por_enemigo = 1.0
golpes_extra_max = 12
forma = 1
forma_apunte = 2
forma_desde_quien_ataca = true
forma_radio = 64.0
forma_reparte = true
suelo_roto = 14
descripcion = "Revientas un frasco de humo a tus pies y, antes de que se aclare, cada uno de los que te rodean se lleva su puñalada. Cuando se disipa siguen peleando, pero ya no contigo."
efectos = [SubResource("SA_0")]
