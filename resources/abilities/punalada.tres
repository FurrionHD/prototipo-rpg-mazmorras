[sub_resource type="Resource" id="NM_pun_punto_debil"]
script = ExtResource("nodo_mejora")
id = &"punto_debil"
nombre = "Punto débil"
descripcion = "Sabes dónde mirar antes de clavar."
padres = Array[StringName]([])
excluye = Array[StringName]([&"herida_abierta"])
nivel_min = 2
dominio = 300
oro = 10000
cambios = {"crit_extra": ["add", 0.2], "potencia": ["presupuesto", 0.5], "potencia_coste": ["presupuesto", 1.0]}

