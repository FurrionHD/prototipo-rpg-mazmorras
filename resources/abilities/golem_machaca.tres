[resource]
script = ExtResource("1")
nombre = "Machaca"
descripcion = "Alza los dos puños de arcilla por encima de la cabeza y los deja caer como un yunque. Se ve venir; apártate o aturdílo antes de que baje."
coste_energia = 0.0
golpes_min = 1
golpes_max = 1
dano_mult = 2.1
carga_turnos = 1
fx_estilo = 23
cooldown = 4
; EN EL MAPA (30/09, constructos paso 1): los dos puños caen en un circulo r30 DELANTE; cargado 1 turno, la huella se
; queda roja toda la carga (el que se sale, se libra). Pega a todos los de dentro.
forma = 1
forma_apunte = 1
forma_radio = 30.0
area_modo = 1
area_secundario = 1.0
; EFECTO EN EL MAPA (30/09, constructos paso 2): el suelo REVIENTA (el estallido: golpe seco, corre rapido) y sobre cada uno
; de dentro el aplaston de barro, mas gordo (ConstructoAire).
fx_estilo_mapa = 181
suelo_roto = 2
; SU GESTO: el del basico (hasta que tenga la suya con los dos puños, paso 3), con su tiempo de golpe.
fx_anim = &"golem_machaca"
