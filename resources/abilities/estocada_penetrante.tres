[resource]
script = ExtResource("1")
nombre = "Estocada penetrante"
inicial = true
coste_energia = 46
cooldown = 4
golpes_min = 1
golpes_max = 1
dano_mult = 1.8
fx_estilo = 41
efectos = [SubResource("SA_vuln")]
efectos_por_golpe = true
forma = 3
forma_apunte = 1
forma_radio = 99.0
forma_ancho = 8.0
penetracion_extra = 0.2
descripcion = "Una estocada precisa que busca el hueco de la armadura y perfora la guardia del enemigo. Se apoya en el crítico alto del estoque."
; EL ARBOL (24/11, cerrado con el jefe): lo escribe tools/arboles_habilidades.py, no tocarlo a mano.
