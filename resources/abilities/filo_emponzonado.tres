[resource]
script = ExtResource("1")
nombre = "Filo emponzoñado"
precio = 2500
coste_energia = 36
cooldown = 5
dano_mult = 0.0
fx_estilo = 38
imbue_estado = 0
imbue_usos = 5
imbue_prob = 0.7
imbue_por_destreza = true
; (24/11, el jefe) POR TIER DEL ARMA: tier impar 1-2 dosis (60/40), par 2-3; el TIPO de veneno cada 2 tiers (Veneno, Ponzoña,
; Toxina...: StatusEffects.veneno_de_tier). Antes (03/10) LA ESCALERA: 70% de que prenda y, si prende, las dosis que suma segun el tier del
; arma (una fila por tier; el largo de la fila es su tope). T5: veneno superior u otro efecto, en el futuro.
imbue_escalera = [[0.6, 0.4], [0.0, 0.6, 0.4], [0.6, 0.4], [0.0, 0.6, 0.4], [0.6, 0.4], [0.0, 0.6, 0.4], [0.6, 0.4], [0.0, 0.6, 0.4], [0.6, 0.4], [0.0, 0.6, 0.4]]
descripcion = "Pasas el filo por un frasco turbio y esperas a que agarre. No corta más: corta peor, y eso a veces vale más que cortar hondo."
; EL ARBOL (24/11, cerrado con el jefe): lo escribe tools/arboles_habilidades.py, no tocarlo a mano.
arbol = [SubResource("NM_fil_agarra_mejor"), SubResource("NM_fil_mas_usos"), SubResource("NM_fil_dosis_cargadas"), SubResource("NM_fil_veneno_fuerte"), SubResource("NM_fil_compartir"), SubResource("NM_fil_mano_rapida"), SubResource("NM_fil_acido"), SubResource("NM_fil_ponzona_sangre"), SubResource("NM_fil_toxina"), SubResource("NM_fil_senal")]
