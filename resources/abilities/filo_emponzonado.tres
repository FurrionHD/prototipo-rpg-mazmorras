[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://scripts/items/ability_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/items/nodo_mejora.gd" id="nodo_mejora"]

[sub_resource type="Resource" id="NM_fil_agarra_mejor"]
script = ExtResource("nodo_mejora")
id = &"agarra_mejor"
nombre = "Agarra mejor"
descripcion = "Lo dejas secar un momento más y ya no se va con el primer golpe."
padres = Array[StringName]([])
excluye = Array[StringName]([&"mas_usos"])
nivel_min = 2
dominio = 300
oro = 2000
cambios = {"imbue_prob": ["set", 0.85], "potencia": ["presupuesto", 0.25], "potencia_coste": ["presupuesto", 1.0]}

[sub_resource type="Resource" id="NM_fil_mas_usos"]
