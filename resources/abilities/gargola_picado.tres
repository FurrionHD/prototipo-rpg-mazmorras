[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://scripts/items/ability_data.gd" id="1"]

[resource]
script = ExtResource("1")
nombre = "Picado"
descripcion = "Extiende las alas de piedra, se eleva un instante y se deja caer sobre ti como una losa. El momento que pasa arriba es tu única ventana para pararla."
coste_energia = 0.0
golpes_min = 1
golpes_max = 1
dano_mult = 2.1
carga_turnos = 1
fx_estilo = 21
cooldown = 4
; EN EL MAPA (30/09, constructos paso 1): se eleva y cae como una losa en un circulo r22 LIBRE a 120 px como mucho;
; cargado 1 turno (la huella roja dice donde caera) y se queda alli, como el salto del acechador.
forma = 1
forma_apunte = 3
forma_radio = 22.0
forma_rango = 120.0
salta = true
; EN EL AIRE toda la carga: el cuerpo a cuerpo no le llega, la magia si (lo pidio el usuario, 30/09).
eleva = true
area_modo = 1
area_secundario = 1.0
; EFECTO EN EL MAPA (30/09, constructos paso 2): despega y se queda suspendida toda la carga (la sombra en el suelo); al
; soltar cae a plomo ('picar', las garras tocan en el 6 de 8): el suelo revienta (el ESTALLIDO, como la Machaca) y sobre
; cada uno de dentro el golpe de arriba con piedrecillas, en basalto (ConstructoAire).
fx_anim_carga = &"despegar>vuelo"
fx_anim = &"picar"
fx_anim_interrumpe = &"picar"
fx_estilo_mapa = 183
suelo_roto = 2
