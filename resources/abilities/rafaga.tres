fx_estilo = 36
forma = 2
forma_apunte = 1
forma_radio = 59.0
forma_apertura = 150.0
forma_reparte = true
redirige_al_morir = true
golpes_extra_por_enemigo = 1.15
golpes_extra_por_enemigo_dual = 1.6
efectos = [SubResource("SA_sang")]
efectos_por_golpe = true
descripcion = "Ráfaga de tajos rápidos y superficiales; con dos dagas caen aún más. Cada tajo que acierta puede abrir una herida sangrante."
