excluye = Array[StringName]([])
nivel_min = 3
dominio = 2500
oro = 15000
cambios = {"dano_mult": ["mult", 1.1], "coste_energia": ["add", -6]}

[resource]
script = ExtResource("1")
nombre = "Ráfaga"
inicial = true
coste_energia = 48
coste_energia_dual = 70
cooldown = 4
golpes_min = 3
golpes_max = 3
golpes_dual_min = 5
golpes_dual_max = 5
dano_mult = 0.9
fx_estilo = 36
forma = 2
forma_apunte = 1
forma_radio = 59.0
forma_apertura = 150.0
forma_reparte = true
redirige_al_morir = true
golpes_extra_por_enemigo = 1.15
golpes_extra_por_enemigo_dual = 1.6
efectos = [SubResource("SA_sang")]
efectos_por_golpe = true
descripcion = "Ráfaga de tajos rápidos y superficiales; con dos dagas caen aún más. Cada tajo que acierta puede abrir una herida sangrante."
; EL ARBOL (22/11): PROVISIONAL, de ejemplo para ver la pantalla; el de verdad se diseña con el jefe.
arbol = [SubResource("NM_raf_filo"), SubResource("NM_raf_tajos"), SubResource("NM_raf_abanico"), SubResource("NM_raf_torbellino"), SubResource("NM_raf_brazo"), SubResource("NM_raf_danza"), SubResource("NM_raf_sangre_fria")]
