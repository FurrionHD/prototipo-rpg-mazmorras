oro = 2500
cambios = {"golpes_min": ["add", 1], "golpes_max": ["add", 1], "dano_mult": ["mult", 1.04]}

[sub_resource type="Resource" id="NM_raf_brazo"]
script = ExtResource("nodo_mejora")
id = &"brazo"
nombre = "Brazo largo"
descripcion = "Llegas más lejos con la hoja."
padres = Array[StringName]([&"abanico"])
excluye = Array[StringName]([])
nivel_min = 2
