oro = 2500
cambios = {"forma_radio": ["add", 15.0], "dano_mult": ["mult", 1.06]}

[sub_resource type="Resource" id="NM_raf_danza"]
script = ExtResource("nodo_mejora")
id = &"danza"
nombre = "Danza de cuchillas"
descripcion = "Las dos ramas acaban aquí: la ráfaga pega bastante más y vuelve antes."
padres = Array[StringName]([&"torbellino", &"brazo"])
excluye = Array[StringName]([])
nivel_min = 3
dominio = 1500
oro = 8000
cambios = {"dano_mult": ["mult", 1.15], "cooldown": ["add", -1]}

[sub_resource type="Resource" id="NM_raf_sangre_fria"]
script = ExtResource("nodo_mejora")
id = &"sangre_fria"
nombre = "Sangre fría"
descripcion = "Gastas menos energía en cada ráfaga."
