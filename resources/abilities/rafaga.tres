[ext_resource type="Script" path="res://scripts/items/status_application.gd" id="2"]

[ext_resource type="Script" path="res://scripts/items/nodo_mejora.gd" id="nodo_mejora"]

[sub_resource type="Resource" id="SA_sang"]
script = ExtResource("2")
estado = 1
prob = 0.22

[sub_resource type="Resource" id="NM_raf_filo"]
script = ExtResource("nodo_mejora")
id = &"filo"
nombre = "Filo afilado"
descripcion = "Los tajos entran más limpios."
padres = Array[StringName]([])
excluye = Array[StringName]([])
nivel_min = 1
dominio = 100
oro = 400
cambios = {"dano_mult": ["mult", 1.08]}

[sub_resource type="Resource" id="NM_raf_tajos"]
script = ExtResource("nodo_mejora")
id = &"tajos"
nombre = "Tajos veloces"
descripcion = "Un tajo más en cada ráfaga."
padres = Array[StringName]([&"filo"])
excluye = Array[StringName]([&"abanico"])
nivel_min = 1
dominio = 300
oro = 900
cambios = {"golpes_min": ["add", 1], "golpes_max": ["add", 1], "dano_mult": ["mult", 1.03]}

[sub_resource type="Resource" id="NM_raf_abanico"]
script = ExtResource("nodo_mejora")
id = &"abanico"
nombre = "Abanico"
descripcion = "Abres más el brazo: la ráfaga barre un ángulo más ancho."
padres = Array[StringName]([&"filo"])
excluye = Array[StringName]([&"tajos"])
nivel_min = 1
dominio = 300
oro = 900
cambios = {"forma_apertura": ["add", 40.0], "dano_mult": ["mult", 1.05]}

[sub_resource type="Resource" id="NM_raf_torbellino"]
script = ExtResource("nodo_mejora")
id = &"torbellino"
nombre = "Torbellino"
descripcion = "Otro tajo más, y más rápido."
