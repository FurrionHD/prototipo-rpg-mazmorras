forma_radio = 69.0
forma_apertura = 150.0
suelo_roto = 18
redirige_al_morir = true
descripcion = "No busca el pecho: busca lo que lo sostiene y lo que lo repara. Después de esto se mueve peor y se recompone aún peor."
