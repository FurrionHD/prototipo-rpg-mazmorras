; LAS SIMAS: lo que puebla los pisos 7-12 desde que los constructos se fueron al fondo.
; Todo lo de aqui es de carne, quitina, moho o agua -- nada de piedra, que es lo que no pegaba.
; Los cuatro entran escalonados para que la franja no se vea igual en el 7 que en el 12.
[sub_resource type="Resource" id="E_mico"]
script = ExtResource("2_entrada")
enemy_data = ExtResource("3_mico")
peso = 45.0
piso_min = 7
piso_max = 10

