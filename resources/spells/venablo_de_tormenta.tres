[resource]
script = ExtResource("1")
nombre = "Venablo de tormenta"
frases = Array[String](["Basta de repartir", "Todo el cielo, en un solo sitio"])
rareza = 3
coste_mana = 15
dano_base = 47.66
elemento = 3
hits = 2
descripcion = "El rayo de siempre va saltando de uno a otro y se gasta por el camino. Este no salta: baja entero sobre UNO y baja dos veces. Lo normal es que se quede quieto un rato después."
efectos = [SubResource("SA_rayo"), SubResource("SA_aturde")]
; LA FORMA EN EL MAPA (26/09, su decision): JABALINA de rayo desde la mano en linea recta al primero; son dos lanzas
; y si la primera lo mata, la segunda sigue al de detras (fila_del_proyectil).
forma = 3
forma_radio = 190.0
forma_ancho = 10.0
forma_iman = 28.0
forma_apunte = 1
forma_solo_primero = true
suelo_mapa = 49
; EL ARBOL (22/11): PROVISIONAL, de ejemplo para ver la pantalla; el de verdad se diseña con el jefe.
arbol = [SubResource("NM_ven_punta"), SubResource("NM_ven_largo"), SubResource("NM_ven_carga"), SubResource("NM_ven_atraviesa"), SubResource("NM_ven_tres_lanzas"), SubResource("NM_ven_tormenta")]
