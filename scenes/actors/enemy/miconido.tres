[sub_resource type="Resource" id="SA_ven"]
script = ExtResource("2")
estado = 0
prob = 0.45
cap = 2

; El Veneno de la bocanada de esporas al golpearle (al_ser_golpeado).
[sub_resource type="Resource" id="SA_bocanada"]
script = ExtResource("2")
estado = 0
prob = 1.0

; LOS MUTANTES DEL MICONIDO (09/11, memoria miconido-mutante; numeros provisionales). En linea:
;     Miconido --> Campana palida (la medusa: luz, Destello, Esporas luminosas) --come mas--> Aventurero florecido (el muerto con la
;     campana por cabeza: espada, Estocada, Esporas de infeccion). Las mecanicas (Luz que atrae, Infectado...) llegan en su paso.
[sub_resource type="Resource" id="MUT_campana"]
script = ExtResource("20_mut")
id = &"campana"
nombre = "Campana pálida"
grado = 1
habilidades = Array[ExtResource("21_ab")]([ExtResource("23_lum"), ExtResource("4_mic"), ExtResource("24_des")])
sprite = &"campana"
pesos = {"agilidad": 14, "destreza": 14, "fuerza": 16, "magia": 34, "resistencia": 36, "voluntad": 16}
basico_propio = ExtResource("22_fil")
; el latigazo de filamentos llega a 35 (el sombrero del normal, a 20)
alcance_mult = 1.75
; LUZ QUE ATRAE: al empezar su turno acerca 15 px a los que esten a 60 o menos
atrae_radio = 60.0
atrae_px = 15.0

[sub_resource type="Resource" id="MUT_florecido"]
script = ExtResource("20_mut")
id = &"florecido"
nombre = "Aventurero florecido"
grado = 2
desde = Array[StringName]([&"campana"])
habilidades = Array[ExtResource("21_ab")]([ExtResource("26_inf"), ExtResource("4_mic"), ExtResource("24_des"), ExtResource("27_est")])
sprite = &"florecido"
pesos = {"agilidad": 12, "destreza": 20, "fuerza": 30, "magia": 22, "resistencia": 34, "voluntad": 12}
basico_propio = ExtResource("25_taj")
; la espada del muerto llega mas que los brazos del normal
alcance_mult = 1.5
atrae_radio = 60.0
atrae_px = 15.0
; NO SIENTE EL DOLOR: aguante al control 0,7 (el normal, 0,3)
resist_aturdir = 0.7

[resource]
script = ExtResource("1")
dureza = 1.0
enemy_name = "Micónido"
historia = "Un hongo del tamaño de un hombre que aprendió a andar. No tiene ojos ni boca; el sombrero se orienta hacia donde nota el aire moverse, y con eso le basta."
color = Color(0.52, 0.46, 0.3, 1)
escala_visual = 2.0
sprite_gen = &"miconido"
; (09/11) estrena VOLUNTAD y la Bocanada pasa a magica: mas Magia (memoria miconido-mutante).
resistencia = 48
fuerza = 26
destreza = 12
agilidad = 10
magia = 22
voluntad = 12
base_hp = 78.0
base_attack = 4.4
base_defense = 4.8
base_speed = 3.0
crystal_category_min = 4
crystal_category_max = 6
crystal_category_weights = PackedFloat32Array(0.5, 0.35, 0.15)
drop_material = ExtResource("5_mat")
nucleo = ExtResource("6_nuc")
drop_piso_debut = 7
drop_piso_pleno = 10
al_golpear = [SubResource("SA_ven")]
; (09/11) inmune al Veneno y a la INFECCION: es el propio hongo (no se levanta florecido)
inmune_estados = [0, 61]
resist_elemental = {
6: 1.25,
1: 1.5
}
resist_aturdir = 0.3
fx_basico = 23
habilidades = [ExtResource("3_esp"), ExtResource("4_mic")]
prob_habilidad = 0.55
mutaciones = Array[ExtResource("20_mut")]([SubResource("MUT_campana"), SubResource("MUT_florecido")])
metadata/_custom_type_script = "uid://le6jfvhlcbou"
; ALCANCE del basico en el mapa (30/09): brazos cortos.
alcance = 20.0
; EL BASICO EN EL MAPA (30/09): le deja caer el sombrero encima ('embestida'); en la victima, el aplaston y las
; esporas (SIMA_PORRAZO).
fx_basico_mapa = 156
; PASIVA (30/09, idea del usuario): quien le pega con el arma DE CERCA tiene un 30% de que le suelte una bocanada de
; esporas en la cara, y envenena (Pantalla._pasiva_al_golpearle).
al_ser_golpeado = [SubResource("SA_bocanada")]
al_ser_golpeado_prob = 0.3
al_ser_golpeado_fx = 157
; SU TIEMPO DE GOLPE en el mapa (30/09, revision de sincronia): su basico toca en ese marco (CombatFX.IMPACTO_ANIM_MAPA).
anim_basico = &"golpe_5_8"
cuerpo = Rect2(-13.35, -1.95, 25.65, 14.65)
centro_golpe = Vector2(-0.5, 4.9)
alcance_marcado = 31.65
drop_runa = ExtResource("28_runa")
