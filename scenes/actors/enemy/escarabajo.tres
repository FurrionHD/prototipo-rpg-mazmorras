; LOS MUTANTES DEL ESCARABAJO DE HIERRO (04/11, memoria escarabajo-mutante; numeros provisionales). Dos ramas que se juntan:
;     Escarabajo --> Escarabajo iman (pesado: Pulso, Adherencia, Limaduras)  --come mas--> Iman errante (los dos, Orbita)
;               \--> Escarabajo saeta (agil: Picado, Pega y se va)          --come mas--/
[sub_resource type="Resource" id="MUT_iman"]
script = ExtResource("20_mut")
id = &"iman"
nombre = "Escarabajo imán"
grado = 1
habilidades = Array[ExtResource("21_ab")]([ExtResource("22_pul"), ExtResource("23_emb"), ExtResource("24_cor")])
sprite = &"iman"
pesos = {"agilidad": 12, "destreza": 12, "fuerza": 38, "magia": 18, "resistencia": 52, "voluntad": 18}
adherencia_radio = 60.0
limaduras_tope = 5

[sub_resource type="Resource" id="MUT_saeta"]
script = ExtResource("20_mut")
id = &"saeta"
nombre = "Escarabajo saeta"
grado = 1
habilidades = Array[ExtResource("21_ab")]([ExtResource("25_pic"), ExtResource("26_pas"), ExtResource("27_eli")])
sprite = &"saeta"
pesos = {"agilidad": 50, "destreza": 38, "fuerza": 22, "magia": 8, "resistencia": 16, "voluntad": 16}
pega_y_se_va = 60.0

[sub_resource type="Resource" id="MUT_errante"]
script = ExtResource("20_mut")
id = &"errante"
nombre = "Imán errante"
grado = 2
desde = Array[StringName]([&"iman", &"saeta"])
habilidades = Array[ExtResource("21_ab")]([ExtResource("22_pul"), ExtResource("25_pic"), ExtResource("26_pas"), ExtResource("28_pma")])
sprite = &"errante"
pesos = {"agilidad": 34, "destreza": 26, "fuerza": 20, "magia": 30, "resistencia": 24, "voluntad": 16}
adherencia_radio = 60.0
pega_y_se_va = 60.0
orbita = true

[sub_resource type="Resource" id="SA_peg"]
