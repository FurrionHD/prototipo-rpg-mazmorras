drop_material = ExtResource("5_mat")
drop_chance = 0.4
nucleo = ExtResource("6_nuc")
drop_extra = ExtResource("7_carne")
drop_extra_chance = 0.1
drop_piso_debut = 7
drop_piso_pleno = 10
al_golpear = [SubResource("SA_san"), SubResource("SA_moj")]
resist_elemental = {
2: 0.7,
3: 1.5
}
