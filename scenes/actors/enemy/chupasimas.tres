prob = 0.45

; LOS MUTANTES DE LA CHUPASIMAS (18/11, memoria chupasimas-mutante), de dos ramas y un final:
;     Chupasimas --> COAGULO (costra de sangre, se pega)       --\
;                --> SANGUIJUELA VIDRIADA (bebe mana, rayo)    ----> MADRE DE LAS SIMAS (las dos; resources/mutaciones)
[sub_resource type="Resource" id="MUT_coagulo"]
script = ExtResource("20_mut")
id = &"coagulo"
nombre = "Coágulo"
grado = 1
habilidades = Array[ExtResource("21_ab")]([ExtResource("3_adh"), ExtResource("4_dre")])
sprite = &"coagulo"
pesos = {"agilidad": 15, "destreza": 24, "fuerza": 34, "magia": 10, "resistencia": 46, "voluntad": 26}
; COSTRA DE SANGRE: lo que drena (Drenaje, y pegada cada turno) se le vuelve costra al 150 %, hasta su vida maxima. Con ella
; puesta: fisico x0,5, agua x1,3 (la disuelve), rayo normal; sin ella, lo suyo (agua x0,7, rayo x1,5).
costra_sangre = 1.5
costra_fisico = 0.5
costra_resist = {
2: 1.3,
3: 1.0
}

[sub_resource type="Resource" id="MUT_vidriada"]
script = ExtResource("20_mut")
id = &"vidriada"
nombre = "Sanguijuela vidriada"
grado = 1
habilidades = Array[ExtResource("21_ab")]([ExtResource("22_sor"), ExtResource("23_drm"), ExtResource("24_ray")])
sprite = &"vidriada"
basico_propio = ExtResource("25_bas")
pesos = {"agilidad": 34, "destreza": 20, "fuerza": 14, "magia": 40, "resistencia": 24, "voluntad": 23}
; SED DE MANA: va a por el de mas mana (el mago). Todo su kit MAGICO sin elemento; no se pega.
sed_de_mana = true

[resource]
script = ExtResource("1")
dureza = 1.0
enemy_name = "Chupasimas"
centro_suelo = 0.38
historia = "Una sanguijuela del largo de un brazo que vive en los charcos de las simas. Se deja caer del techo mojada, se pega, y para cuando la notas ya pesa el doble que al empezar."
color = Color(0.42, 0.24, 0.3, 1)
escala_visual = 1.6
sprite_gen = &"chupasimas"
; (16/11, memoria chupasimas-mutante) estrena VOLUNTAD, misma suma 155: el basico pega un 3-4 % mas (tools/tabla_chupasimas).
resistencia = 32
fuerza = 34
destreza = 28
agilidad = 23
magia = 12
voluntad = 26
base_hp = 66.0
base_attack = 4.7
base_defense = 3.4
base_speed = 4.4
crystal_category_min = 5
crystal_category_max = 7
