habilidades = [ExtResource("3_adh"), ExtResource("4_dre")]
mutaciones = Array[ExtResource("20_mut")]([SubResource("MUT_coagulo"), SubResource("MUT_vidriada"), ExtResource("26_mad")])
prob_habilidad = 0.5
