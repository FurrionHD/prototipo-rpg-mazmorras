; LOS MUTANTES DEL ACECHADOR (19/11, memoria acechador-mutante), una linea:
;     Acechador --> SOMBRA SIN ROSTRO (sigilo: se funde en las sombras) --> CAZADOR LUNAR (resources/mutaciones)
; La Sombra pega todo FISICO, con el kit de siempre (Zarpazo doble, Salto a la yugular, Dentellada). Su pasiva
; (Paciencia del cazador) llega en su paso. Stats de tools/tabla_acechador (vida 587 en el piso 10).
[sub_resource type="Resource" id="MUT_sombra"]
script = ExtResource("20_mut")
id = &"sombra"
nombre = "Sombra sin rostro"
grado = 1
sprite = &"sombra"
pesos = {"agilidad": 50, "destreza": 36, "fuerza": 56, "magia": 2, "resistencia": 30, "voluntad": 4}
paciencia_turnos = 3
paciencia_extra = 0.5
pasivas_visibles = Array[int]([72])

