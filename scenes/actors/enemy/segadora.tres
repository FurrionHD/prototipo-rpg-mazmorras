; LOS MUTANTES DE LA SEGADORA (05/11, memoria segadora-mutante; numeros provisionales). En linea:
;     Segadora --> Segadora de sierra (garras x1,4, Zona de siega, Siega) --come mas--> Vendaval rojo (maga de viento: cortes, Vendaval, Vuelo corto)
[sub_resource type="Resource" id="MUT_sierra"]
script = ExtResource("20_mut")
id = &"sierra"
nombre = "Segadora de sierra"
grado = 1
habilidades = Array[ExtResource("21_ab")]([ExtResource("3_gua"), ExtResource("4_ens"), ExtResource("22_sie")])
sprite = &"sierra"
pesos = {"agilidad": 30, "destreza": 58, "fuerza": 66, "magia": 7, "resistencia": 28, "voluntad": 11}
alcance_mult = 1.43
zona_siega = 0.5

[sub_resource type="Resource" id="MUT_vendaval"]
