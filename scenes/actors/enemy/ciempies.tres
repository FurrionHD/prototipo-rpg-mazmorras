; LOS MUTANTES DEL CIEMPIES (05/11, memoria ciempies-mutante; numeros provisionales). En linea:
;     Ciempies carmesi --> Ciempies bicefalo (dos cabezas, Dos mentes, basico en U, Pinza) --come mas--> Nudo carmesi (enorme, atrapa a dos, Derrumbe)
[sub_resource type="Resource" id="MUT_bicefalo"]
script = ExtResource("20_mut")
id = &"bicefalo"
nombre = "Ciempiés bicéfalo"
grado = 1
habilidades = Array[ExtResource("21_ab")]([ExtResource("3_fre"), ExtResource("4_mor"), ExtResource("22_pin")])
sprite = &"bicefalo"
pesos = {"agilidad": 32, "destreza": 40, "fuerza": 43, "magia": 9, "resistencia": 34, "voluntad": 12}
dos_mentes = true
basico_propio = ExtResource("24_bu")
basico_una_cabeza = ExtResource("25_bun")
cabeza_libre_mult = 0.6
cabeza_libre_radio = 70.0

[sub_resource type="Resource" id="MUT_nudo"]
