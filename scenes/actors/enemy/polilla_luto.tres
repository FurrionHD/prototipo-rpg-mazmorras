; LOS MUTANTES DE LA POLILLA DE LUTO (12/11, memoria polilla-mutante): el arbol es el de la polilla de esporas.
;     Polilla de luto --> Mortaja alada (OSCURIDAD) --come mas--> Polilla insomne (la mezcla, compartida: resources/mutaciones)
[sub_resource type="Resource" id="MUT_mortaja"]
script = ExtResource("20_mut")
id = &"mortaja"
nombre = "Mortaja alada"
grado = 1
habilidades = Array[ExtResource("21_ab")]([ExtResource("22_nce"), ExtResource("23_aso"), ExtResource("24_amo")])
sprite = &"mortaja"
pesos = {"agilidad": 44, "destreza": 22, "fuerza": 12, "magia": 46, "resistencia": 18, "voluntad": 28}
; su basico pega de OSCURIDAD
elemento = 5

[resource]
script = ExtResource("1")
dureza = 0.5
familia = 3
enemy_name = "Polilla de luto"
centro_suelo = 0.49
historia = "La otra polilla de las simas, la que baja en vez de subir. En las alas lleva dibujada una calavera, y en los pisos hondos nadie se ha parado a mirarla tanto como para saber si es casualidad."
color = Color(0.58, 0.5, 0.6, 1)
escala_visual = 1.9
sprite_gen = &"polilla"
; (12/11) EL DIBUJO D (la calavera; Polilla3DSprites carga assets/sprites/enemigos/polilla_sdf_d con su mismo tinte).
sprite_variante = &"luto"
; (12/11, memoria polilla-mutante) las stats del pavon: con VOLUNTAD y la Nube y el Aleteo pasan a MAGICOS; siguen sumando 170 y "tienen
; que ser muy agiles TODAS". El basico pega un 4 % menos (menos Fuerza; tools/tabla_polilla.gd).
resistencia = 22
fuerza = 24
destreza = 30
agilidad = 42
magia = 28
voluntad = 24
; (12/11) un poco MAS FUERTE que el pavon: vida 58 -> 66 y ataque +10 %. El mismo kit.
base_hp = 66.0
base_attack = 5.5
base_defense = 3.2
base_speed = 5.2
crystal_category_min = 6
crystal_category_max = 8
crystal_category_weights = PackedFloat32Array(0.4, 0.4, 0.2)
drop_material = ExtResource("5_mat")
nucleo = ExtResource("6_nuc")
drop_piso_debut = 11
drop_piso_pleno = 12
al_golpear = [SubResource("SA_ven")]
inmune_estados = [0]
vuela = true
resist_elemental = {
6: 1.5,
1: 1.6,
5: 0.7
}
eficacia = 1.3
fx_basico = 116
habilidades = [ExtResource("3_nub"), ExtResource("4_ale")]
prob_habilidad = 0.6
mutaciones = Array[ExtResource("20_mut")]([SubResource("MUT_mortaja"), ExtResource("25_ins")])
metadata/_custom_type_script = "uid://le6jfvhlcbou"
; ALCANCE del basico en el mapa (30/09).
alcance = 20.0
; EL BASICO EN EL MAPA (30/09): se lanza ('embestida') y en ti, un roce de ala polvoriento (SIMA_ALA).
fx_basico_mapa = 163
; PASIVA (30/09, idea del usuario: "a este mejor matarlo a distancia"): quien le pega con el arma DE CERCA tiene un
; 30% de llevarse su polvo en la cara, y ciega (Pantalla._pasiva_al_golpearle).
al_ser_golpeado = [SubResource("SA_polvo")]
al_ser_golpeado_prob = 0.3
al_ser_golpeado_fx = 164
; SU TIEMPO DE GOLPE en el mapa (30/09, revision de sincronia): su basico toca en ese marco (CombatFX.IMPACTO_ANIM_MAPA).
anim_basico = &"golpe_5_8"
cuerpo = Rect2(-13.68, -17.11, 31.95, 18.58)
centro_golpe = Vector2(0.68, -8.68)
alcance_marcado = 22.26
; (12/11) LA RUNA de su set Concentracion (la sueltan sobre todo sus mutantes: Runas.DROP_RUNA).
drop_runa = ExtResource("26_runa")
