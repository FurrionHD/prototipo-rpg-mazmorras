pesos = {"agilidad": 42, "destreza": 18, "fuerza": 12, "magia": 50, "resistencia": 20, "voluntad": 28}
; su basico pega de LUZ
elemento = 4

[resource]
script = ExtResource("1")
dureza = 0.5
