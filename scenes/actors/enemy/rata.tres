; LOS MUTANTES DE LA RATA (30/10, diseño y numeros del jefe: memoria rata-mutante). Un arbol de dos ramas que se juntan:
;     Rata --muta--> Rata sombria (sigilo, se aparta de un salto)  --come mas--> Rata de cuarzo ahumado (las dos)
;              \--> Rata drusa (resiste magia, fragil a contundentes) --come mas--/
; Pesos de stats con las SEIS (suma 150). Tablas de stats, las de los slimes (MUT_* y MUT2_*).
[sub_resource type="Resource" id="MUT_sombria"]
script = ExtResource("8_mut")
id = &"sombria"
nombre = "Rata sombría"
grado = 1
habilidades = Array[ExtResource("9_ab")]([ExtResource("10_mso"), ExtResource("11_fso"), ExtResource("12_tra")])
sprite = &"sombria"
pesos = {"agilidad": 46, "destreza": 42, "fuerza": 22, "magia": 12, "resistencia": 14, "voluntad": 14}
sigilo_prob = 0.5
salto_esquiva = 40.0

[sub_resource type="Resource" id="MUT_drusa"]
script = ExtResource("8_mut")
id = &"drusa"
nombre = "Rata drusa"
grado = 1
habilidades = Array[ExtResource("9_ab")]([ExtResource("13_mcr"), ExtResource("14_fes"), ExtResource("15_emb")])
sprite = &"drusa"
pesos = {"agilidad": 24, "destreza": 26, "fuerza": 26, "magia": 8, "resistencia": 26, "voluntad": 40}
fragil_contundente = 1.3
resiste_magia = 0.6

[sub_resource type="Resource" id="MUT_cuarzo"]
script = ExtResource("8_mut")
