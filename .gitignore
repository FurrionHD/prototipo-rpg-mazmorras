# Godot 4+ specific ignores
.godot/
/android/

# Bancos de pruebas temporales (dev_*): se crean para verificar algo y se borran al terminar.
# Van ignorados para que un `git add -A` a media sesion no los cuele en un commit. Se escriben en la
# RAIZ (tienen que estar dentro de res:// para ver los autoloads y los class_name) y se borran ahi
# mismo; el 31/08/2026 se limpiaron 32 que llevaban meses acumulandose.
dev_*.gd
dev_*.tscn
dev_*.uid
dev_*.png

# ...MENOS los cuatro VISORES, que son utillaje del repo y no una prueba de una tarde. Viven en
# tools/visores/ y cada uno tiene su lanzador en herramientas/ -- y ESE si estaba commiteado, asi que
# quien clonara el repo se encontraba el .bat sin el visor al que llama: un doble clic y un error.
!dev_gestos.*
!dev_enemigos_animaciones.*
!dev_enemigos_ataques.*
!dev_jugador_animaciones.*
!dev_celdas.*
!dev_inventario.*
!dev_tiers.*
!dev_personaje.*
!dev_magia_arma.*
!dev_tienda.*
!dev_tochos.*
!dev_grimorios.*
!dev_panel_hechizos.*
!dev_fx_hechizo.*
!dev_magias.*
# ver_maestro.bat llevaba commiteado desde que existe el maestro, pero su visor NO estaba en esta
# lista: el .bat sin el dev_ al que llama es justo el doble clic con error que explica el parrafo de
# arriba. Se cazo al añadir el del gacha.
!dev_maestro.*
!dev_gacha.*
# Y volvio a pasar EXACTAMENTE IGUAL con el de la animacion previa: ver_ritual.bat entro en el commit
# y dev_ritual.* se quedo fuera, ignorado en silencio. Al crear un visor nuevo, la linea de aqui va
# EN EL MISMO commit que su .bat -- 'git add -A' no avisa de lo que no añade.
!dev_ritual.*
# TERCERA VEZ, y con el mismo sintoma exacto: ver_imbuiciones.bat entro en su commit y
# dev_imbuiciones.* se quedo fuera. 'git add -A' no dice nada de lo que NO añade, asi que el commit
# se ve limpio y el fallo aparece semanas despues, en otra maquina, como un doble clic con error.
# Si estas creando un visor: esta linea va EN EL MISMO commit que su .bat, y se comprueba con
# `git status --short` mirando que aparezcan los DOS.
!dev_imbuiciones.*
# CUARTA. Esta vez el aviso funciono: 'git add' se nego en voz alta al añadir dev_amagos y por eso
# ver_amagos.bat y su visor entran juntos. La regla, otra vez: la linea va EN EL MISMO commit.
!dev_amagos.*

# Salida de las herramientas de vista previa (tools/ver_terreno.gd): son PNG para MIRAR el
# arte mientras se dibuja, no parte del juego. Se regeneran con la herramienta cuando hagan falta.
tools/salida/

# Cachés de los guiones de herramientas
__pycache__/
